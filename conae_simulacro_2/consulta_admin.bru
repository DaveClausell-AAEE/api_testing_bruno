meta {
  name: Consulta Telemetria Admin
  type: http
  seq: 1
}

get {
  url: http://localhost:5000/api/v1/saocom/telemetria
  body: none
  auth: none
}

headers {
  Authorization: tok-admin-999
}

assert {
  res.status: eq 200
  res.body.estado: eq OK
  res.body.rol_consultante: eq ADMINISTRADOR
}
